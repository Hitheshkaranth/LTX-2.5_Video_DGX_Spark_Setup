# ./setup.sh creates .env (git-ignored) from this file and asks for the password.
# Or copy it to .env yourself and fill it in.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional. Defaults bind to localhost only; use 0.0.0.0 to reach Grafana from your LAN/tailnet.
GRAFANA_BIND=127.0.0.1
# 3001, not 3000, so it does not clash with a Grafana you may already run
GRAFANA_PORT=3001
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
